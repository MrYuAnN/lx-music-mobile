             callback.reject("no_current_item", "There is no current item in the player")
 
         Arguments.toBundle(map)?.let {
+            // fork semantics: this replaces the queue item, so a bare metadata map
+            // (lx-style notification updates carry no url) poisons the current item
+            // with a "null" uri, killing playback with an ENOENT loop. Reuse the
+            // current item's url when the caller didn't supply one.
+            if (!it.containsKey("url")) {
+                val current = musicService.currentTrack
+                current.uri?.let { u -> it.putString("url", u.toString()) }
+            }
             val track = bundleToTrack(it)
             musicService.updateNowPlayingMetadata(track)
         }
