<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- edge-to-edge 启动底色对齐主题（DayNight 双资源，弹窗体系批 §问题2） -->
        <item name="android:windowBackground">@color/launch_window_background</item>
    </style>

    <!-- F-1 无白屏（拍板 A）：splash 保持到内容就绪——MainActivity 用本主题，
         JS containerReady 解除；postSplashScreenTheme 指回 AppTheme（edge-to-edge/
         窗口配置原样继承），splash 底色走 DayNight 资源自动切深浅 -->
    <style name="AppThemeSplash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
